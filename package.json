{
  "name": "anytune",
  "version": "0.1.0",
  "private": true,
  "description": "Tune any instrument. An OBINexus tuning application built with OBIX and Obicall.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/obinexus/anytune"
  },
  "homepage": "https://anytune.obinexus.org",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "vite",
    "dev:vue": "vite",
    "dev:native": "vite --mode native",
    "build": "vite build",
    "build:vue": "vite build",
    "build:native": "vite build --mode native",
    "preview": "vite preview",
    "preview:native": "vite preview --mode native",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:architecture": "node --test \"tests/architecture/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "trace": "node tools/obix/write-trace.ts"
  },
  "devDependencies": {
    "@obinexusltd/obix-compiler-diagnostics": "file:../obix-recovery/compiler/obix-compiler-diagnostics",
    "@obinexusltd/obix-compiler-dop": "file:../obix-recovery/compiler/obix-compiler-dop",
    "@obinexusltd/obix-compiler-ir": "file:../obix-recovery/compiler/obix-compiler-ir",
    "@obinexusltd/obix-compiler-parser": "file:../obix-recovery/compiler/obix-compiler-parser",
    "@obinexusltd/obix-compiler-script": "file:../obix-recovery/compiler/obix-compiler-script",
    "@obinexusltd/obix-compiler-script-setup": "file:../obix-recovery/compiler/obix-compiler-script-setup",
    "@obinexusltd/obix-compiler-sfc": "file:../obix-recovery/compiler/obix-compiler-sfc",
    "@obinexusltd/obix-compiler-template": "file:../obix-recovery/compiler/obix-compiler-template",
    "@obinexusltd/obix-compiler-typescript": "file:../obix-recovery/compiler/obix-compiler-typescript",
    "@types/node": "22.20.4",
    "axe-core": "4.13.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.1"
  },
  "dependencies": {
    "@obinexusltd/obix-runtime-browser": "file:../obix-recovery/runtime/obix-runtime-browser",
    "@obinexusltd/obix-runtime-component": "file:../obix-recovery/runtime/obix-runtime-component",
    "@obinexusltd/obix-runtime-dom": "file:../obix-recovery/runtime/obix-runtime-dom",
    "@obinexusltd/obix-runtime-reactivity": "file:../obix-recovery/runtime/obix-runtime-reactivity",
    "vue": "3.5.43"
  },
  "imports": {
    "#anytune-mount": "./src/harness/mount.ts"
  }
}
