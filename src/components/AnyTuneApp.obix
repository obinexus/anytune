<script setup lang="ts">
import InstrumentSelector from "./InstrumentSelector.obix";
import InputSelector from "./InputSelector.obix";
import TunerDisplay from "./TunerDisplay.obix";
import InputStatus from "./InputStatus.obix";

// the view of the application state (src/app/view.ts), field by field: the UI binds it and formats nothing
defineProps<{
  session: string;
  sessionText: string;
  listening: boolean;
  instrumentId: string;
  instrumentName: string;
  instruments: { id: string; name: string; selected: boolean }[];
  hasReading: boolean;
  note: string;
  octaveText: string;
  targetText: string;
  frequencyText: string;
  centsText: string;
  status: string;
  statusText: string;
  stable: boolean;
  needlePercent: number;
  confidencePercent: number;
  confidenceText: string;
  inputText: string;
  inputSourceText: string;
  inputId: string;
  inputOptions: { id: string; label: string; selected: boolean }[];
  privacyText: string;
  hasError: boolean;
  errorText: string;
  summaryText: string;
  announcement: string;
}>();

// the user's intents, for the application service — the UI never starts, stops or tunes anything itself
const emit = defineEmits<{ (e: "select-instrument", id: string): void; (e: "select-input", id: string): void; (e: "start"): void; (e: "stop"): void }>();
</script>

<template>
  <main class="anytune">
    <header class="masthead">
      <h1>AnyTune</h1>
      <p class="tagline">Tune any instrument</p>
    </header>
    <InstrumentSelector :instruments="instruments" @select="(id: string) => emit('select-instrument', id)" />
    <InputSelector :inputs="inputOptions" @select="(id: string) => emit('select-input', id)" />
    <div class="controls">
      <button v-if="!listening" type="button" class="start" @click="emit('start')">Start tuning</button>
      <button v-else type="button" class="stop" @click="emit('stop')">Stop</button>
    </div>
    <!-- right under Start: an error far below the tuner is out of sight, and Start seems to do nothing -->
    <p v-if="hasError" class="error" role="alert">{{ errorText }}</p>
    <TunerDisplay
      :note="note"
      :octave-text="octaveText"
      :frequency-text="frequencyText"
      :cents-text="centsText"
      :status="status"
      :status-text="statusText"
      :stable="stable"
      :needle-percent="needlePercent"
      :confidence-percent="confidencePercent"
      :confidence-text="confidenceText"
      :announcement="announcement"
    />
    <InputStatus :session-text="sessionText" :input-source-text="inputSourceText" :privacy-text="privacyText" :input-text="inputText" />
    <p class="summary">{{ summaryText }}</p>
  </main>
</template>
