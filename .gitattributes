# .obr journals are binary: never convert their line endings (a CRLF conversion would tear every record)
*.obr binary

# Standard MIDI Files are binary
*.mid binary
*.midi binary

# shell scripts run on Linux and in WSL: always LF; Windows batch files: CRLF
gradlew text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
